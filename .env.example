# bam-landing-page env vars
# Copy to `.env.local` and fill. All values fake here; never commit real secrets.

# --- Database (MongoDB) ---
# Three legacy variable names are referenced across the codebase. Standardize
# on MONGODB_URI long-term; keep the others set to the same value until a
# future plan consolidates the references.
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/bam_portfolio?retryWrites=true&w=majority"
MONGODB_CONNECTION_STRING="mongodb+srv://user:pass@cluster.mongodb.net/bam_portfolio?retryWrites=true&w=majority"
MONGO_URI="mongodb+srv://user:pass@cluster.mongodb.net/bam_portfolio?retryWrites=true&w=majority"
# Generic fallback used by some route handlers:
DATABASE_URL="mongodb+srv://user:pass@cluster.mongodb.net/bam_portfolio?retryWrites=true&w=majority"

# --- Auth (NextAuth v4) ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# JWT signing used by custom auth paths alongside NextAuth:
JWT_SECRET="generate-with-openssl-rand-base64-32"

# --- Ecosystem SSO: "Sign in with WitUS" (ALL OPTIONAL) ---
# LEAVE THESE UNSET AND NOTHING HAPPENS. The OIDC provider is only registered when
# WITUS_OIDC_CLIENT_ID is set, so with no value the WitUS button never renders, the
# "Continue as <name>" probe never fires, and Logout stays local -- the login page is
# exactly the email + password form it has always been.
#
# SSO IS A SECOND WAY IN, NOT A REPLACEMENT (BAM, 2026-09-02). The credentials provider is
# untouched and stays primary: an IdP outage, a rotated secret, or a revoked client must
# never lock BAM out of his own admin. Unsetting these reverts the site cleanly.
#
# ADMIN IS STILL DECIDED HERE, NOT BY THE IdP. Both providers require a
# `bam_portfolio.users` document with `role: "admin"` for the signing-in email;
# lib/auth/authorize.ts gates /admin/* and /api/admin/* on it. A WitUS account with no such
# record is refused. The IdP proves WHO you are; this database decides WHETHER you are admin.
#
# Registered in the IdP registry (gemini/witus lib/identity/clients.ts) as slug `bam`.
# The callback is /api/auth/callback/witus (NextAuth v4 shape), registered for BOTH
# https://www.brandanthonymcdonald.com and the apex -- NextAuth v4 on Vercel builds the
# redirect_uri from x-forwarded-host and IGNORES NEXTAUTH_URL.
WITUS_OIDC_CLIENT_ID="witus-bam"
# Must equal WITUS_OIDC_SECRET__BAM on the witus.online project, exactly.
WITUS_OIDC_CLIENT_SECRET="same-string-as-WITUS_OIDC_SECRET__BAM-on-witus.online"
# Optional. Only for pointing at a non-production IdP; every other IdP URL (the endsession
# endpoint, the session probe) is DERIVED from this one, so the host is named in one place.
# Unset in production -- the code falls back to the accounts.witus.online discovery doc.
# WITUS_OIDC_DISCOVERY_URL="https://accounts.witus.online/api/idp/.well-known/openid-configuration"

# --- Admin ---
ADMIN_EMAIL="admin@example.com"
ADMIN_API_KEY="some-server-only-admin-key"

# --- reCAPTCHA v3 (workout feedback + contact forms) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6LcXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
RECAPTCHA_SECRET_KEY="6LcYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY"

# --- WitUS Inbox webhook (Track E hire/partner forms) ---
# Endpoint: POST /api/ingest on the Inbox app. Use the localhost URL during dev.
INBOX_INGEST_URL="https://inbox.witus.online/api/ingest"
# Shared HMAC secret. Inbox side stores this in INGEST_SOURCES[*].hmac_secret
# for the matching slug. Must be ≥16 chars.
INBOX_INGEST_SECRET="shared-secret-from-inbox-INGEST_SOURCES-config"
# Source slug — must be pre-registered on the Inbox side (INGEST_SOURCES[].slug).
INBOX_SOURCE_SLUG="bam-landing-page"

# --- WitUS Outbox webhook (blog-publish → social drafts) ---
# Receiver endpoint. Production: https://outbox.witus.online/api/ingest.
# Local: http://localhost:3000/api/ingest (when outbox is running locally).
OUTBOX_INGEST_URL="http://localhost:3000/api/ingest"
# Source slug — must match the outbox INGEST_SOURCES[].slug entry exactly.
OUTBOX_SOURCE_SLUG="bam-landing-page"
# 64-char hex HMAC secret matching outbox INGEST_SOURCES[bam-landing-page].hmac_secret.
OUTBOX_INGEST_SECRET="64-char-hex-from-outbox-INGEST_SOURCES-config"
# Master kill-switch. Default unset = OFF. Set to "true" to enable triggers.
# OUTBOX_TRIGGER_ENABLED="true"
# BAM's user id in this app's auth (the only id that fires triggers during smoke).
PRODUCT_OWNER_USER_ID="bam-mongo-user-id"

# --- SMTP (nodemailer, outbound email from form notifications) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-pass"

# --- Cloudinary (media) ---
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Google Gemini (AI features) ---
# Server-only. The interactive blog demos call /api/ai/gemini, which holds this
# key; it is never sent to the browser.
GEMINI_API_KEY="your-gemini-api-key"

# --- AI system prompt override ---
# Read server-side by /api/ai/gemini for the 'keyword-coach' persona.
SYSTEM_PROMPT=""

# --- Error monitoring: Better Stack via the Sentry SDK (ALL OPTIONAL) ---
# Better Stack ingests over the Sentry protocol, so its ingest URL goes in SENTRY_DSN as-is.
# LEAVE THESE UNSET AND NOTHING HAPPENS: every Sentry init is guarded on the DSN, so with no value
# the SDK never initializes, no event is sent, and the site behaves exactly as it does today.
# Server + edge runtimes:
SENTRY_DSN=""
# Browser runtime. Same DSN. Public by design: it is inlined into the client bundle, and a DSN is a
# write-only ingest key, not a secret. NEXT_PUBLIC_* is baked in at BUILD time, so changing it
# requires a redeploy, not just a restart.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional environment label. Defaults to VERCEL_ENV, then NODE_ENV.
# SENTRY_ENVIRONMENT="production"
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# Optional, for readable stack traces instead of minified ones: source maps upload at build time only
# when all three are set. Without them the build SKIPS the upload rather than failing.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# --- Node runtime flag (rarely set manually) ---
# NODE_ENV="development"
